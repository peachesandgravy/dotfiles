eval "$(/opt/homebrew/bin/brew shellenv)"

export TERMINAL=/Applications/iTerm.app
export EDITOR=nvim
export BROWSER=zen

# MacPorts Installer addition on 2026-08-14_at_11:11:48: adding an appropriate PATH variable for use with MacPorts.
export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
