#!/bin/zsh

# colourize
alias ls="ls --color=auto"
alias grep="grep --color=auto"

# universal
alias ll="ls -al"
alias ff="fastfetch"
alias shrc="$EDITOR ~/.zshrc"
alias aliasrc="$EDITOR ~/.zaliases"
alias lazyrc="$EDITOR ~/.config/nvim/lua/config/lazy.lua"
alias specrc="$EDITOR ~/.config/nvim/lua/plugins/spec.lua"
alias kittyrc="$EDITOR ~/.config/kitty/kitty.conf"
alias yac='open /Applications/YACReader.app'

# macos only
alias resetdock="defaults delete com.apple.dock; killall Dock"
alias unrar="tar -xf" # comment on linux or unrar will not work
alias lsblk="diskutil list" # comment on linux or lsblk will not work
alias htop="sudo htop"
